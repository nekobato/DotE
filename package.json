{
  "name": "dot-e",
  "version": "0.0.23",
  "author": {
    "name": "nekobato",
    "email": "nekobato@gmail.com"
  },
  "license": "MIT",
  "description": "Fediverse client for desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/nekobato/dote.git"
  },
  "scripts": {
    "prepare": "rm -rf node_modules/electron/dist && node node_modules/electron/install.js",
    "dev": "vite",
    "build:app": "pnpm prepare && vue-tsc && vite build",
    "build": "pnpm build:app && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.cjs -c.mac.identity=- -c.mac.notarize=false",
    "release": "pnpm build:app && electron-builder --publish always -c --config electron-builder.config.cjs",
    "build:icon": "electron-icon-builder --input=./public/images/logo/icon.png --output=./public",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit",
    "test": "vitest run",
    "press": "vitepress dev docs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "website:dev": "vitepress dev website",
    "website:build": "vitepress build website",
    "website:preview": "vitepress preview website"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1",
    "pnpm": ">=8"
  },
  "main": "./dist-electron/index.js",
  "dependencies": {
    "@atproto/api": "0.28.0",
    "@atproto/jwk-jose": "0.2.4",
    "@atproto/oauth-client": "0.8.10",
    "@atproto/oauth-client-node": "0.5.10",
    "@sentry/electron": "8.2.0",
    "electron-fetch": "1.9.1",
    "electron-log": "5.4.4",
    "electron-store": "12.0.0",
    "electron-updater": "6.8.10",
    "font-list": "2.1.0"
  },
  "devDependencies": {
    "@iconify/vue": "5.0.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vueuse/core": "15.0.0",
    "bowser": "2.14.1",
    "electron": "44.9.1",
    "electron-builder": "26.17.0",
    "electron-icon-builder": "2.0.1",
    "element-plus": "2.14.7",
    "mfm-js": "0.27.0",
    "misskey-js": "2026.10.0",
    "nanoid": "6.0.2",
    "pinia": "4.1.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "sass-embedded": "1.105.2",
    "stylelint": "17.16.0",
    "stylelint-config-rational-order": "0.1.2",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-order": "8.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-electron": "1.1.2",
    "vite-plugin-electron-renderer": "1.0.0",
    "vite-plugin-resolve": "2.5.2",
    "vitepress": "1.6.4",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "pnpm@11.5.3"
}
